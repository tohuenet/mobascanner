{
  "manifest_version": 3,
  "name": "moba-scanner companion",
  "version": "0.1.0",
  "description": "Capture the current browsing session and feed it to a local moba-scanner for security testing.",
  "permissions": ["activeTab", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Send to moba-scanner",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
