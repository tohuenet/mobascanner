# Keep the build context tiny — Docker copies everything here into the daemon.

# Node + Next artifacts (builder regenerates these inside the image)
node_modules
.next
.turbo

# VCS + tooling
.git
.gitignore
.gitattributes
.claude
.vscode
.idea

# Local persistence + logs (bind-mounted at runtime, not baked into image)
data
*.log
scripts/output*

# Don't recursively include Docker files themselves in the context
Dockerfile
docker-compose*
.dockerignore

# OS junk
.DS_Store
Thumbs.db

# Plans / notes the user keeps locally
*.local.md
